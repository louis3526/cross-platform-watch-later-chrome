{
  "manifest_version": 3,
  "name": "跨平台稍後觀看自動播放器 (YouTube & Bilibili)",
  "version": "1.0.0",
  "description": "混合收納 YouTube 與 Bilibili 稍後觀看影片，自訂拖曳排序，支援跨平台全自動連續播放！",
  "browser_specific_settings": {
    "gecko": {
      "id": "cross-platform-watch-later@louis3526.github.io",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "contextMenus",
    "scripting",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtu.be/*",
    "*://*.bilibili.com/*",
    "*://*.tiktok.com/*",
    "*://*.facebook.com/*",
    "https://api.bilibili.com/*",
    "https://noembed.com/*",
    "https://api.cl1p.net/*",
    "https://api.npoint.io/*"
  ],
  "background": {
    "scripts": [
      "i18n.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "跨平台稍後觀看播放器",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
